load("@rules_cc//cc/toolchains:args.bzl", "cc_args")

package(default_visibility = ["//visibility:public"])

cc_args(
    name = "sysroot",
    actions = [
        "@rules_cc//cc/toolchains/actions:compile_actions",
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    args = ["--sysroot={freebsd_sysroot}"],
    data = ["//runtimes/freebsd:sysroot"],
    format = {
        "freebsd_sysroot": "//runtimes/freebsd:sysroot",
    },
    target_compatible_with = ["@platforms//os:freebsd"],
)

cc_args(
    name = "headers_include_search_path",
    actions = ["@rules_cc//cc/toolchains/actions:source_compile_actions"],
    args = [
        "-isystem",
        "{freebsd_headers}",
    ],
    data = ["//runtimes/freebsd:headers"],
    format = {
        "freebsd_headers": "//runtimes/freebsd:headers",
    },
    target_compatible_with = ["@platforms//os:freebsd"],
)
