load("@rules_cc//cc/toolchains/impl:documented_api.bzl", "cc_args_list")

package(default_visibility = ["//visibility:public"])

# This package owns Windows semantic implementations and selects their
# Windows-local ABI, CRT, SDK, and runtime variants. Complete rules_cc argument
# ordering and composition remains in //toolchain and //toolchain/runtimes.

cc_args_list(
    name = "mingw_default_libs",
    args = [
        "//toolchain/args/windows/mingw:default_library_search_paths",
    ] + select({
        "//constraints/windows/crt:msvcrt": ["//toolchain/args/windows/mingw:msvcrt_default_libs"],
        "//constraints/windows/crt:ucrt": ["//toolchain/args/windows/mingw:ucrt_default_libs"],
    }),
)

cc_args_list(
    name = "msvc_default_link_flags",
    args = [
        "//toolchain/args/windows/msvc:common_default_link_flags",
    ] + select({
        "//toolchain/features/msvc:static_crt_config": ["//toolchain/args/windows/msvc:msvc_static_runtime_library_path"],
        "//conditions:default": ["//toolchain/args/windows/msvc:msvc_dynamic_runtime_library_path"],
    }),
)

cc_args_list(
    name = "default_link_flags",
    args = select({
        "//constraints/windows/abi:msvc": ["msvc_default_link_flags"],
        "//conditions:default": [],
    }),
)

cc_args_list(
    name = "default_startfiles",
    args = select({
        "//constraints/windows/abi:msvc": [],
        "//conditions:default": ["//toolchain/args:crt_search_directory"],
    }),
)

cc_args_list(
    name = "resource_dir",
    # The fixed native MSVC-ABI route uses the clang-cl personality. Keep the
    # personality implementation outside this package and compose it here at
    # the supported Windows route boundary.
    args = select({
        "//constraints/windows/abi:msvc": ["//toolchain/args:clang_cl_resource_dir"],
        "//conditions:default": ["//toolchain/args:resource_dir"],
    }),
)

cc_args_list(
    name = "default_libs",
    args = select({
        "//constraints/windows/abi:msvc": [],
        "//conditions:default": ["mingw_default_libs"],
    }),
)

cc_args_list(
    name = "cxxstdlib_library_search_paths",
    args = select({
        "//constraints/windows/abi:msvc": ["//toolchain/args/windows/msvc:libcxx_library_search_path"],
        "//conditions:default": ["//toolchain/args:cxxstdlib_library_search_paths"],
    }),
)

cc_args_list(
    name = "libunwind_library_search_paths",
    args = select({
        "//constraints/windows/abi:msvc": [],
        "//conditions:default": ["//toolchain/args:libunwind_library_search_paths"],
    }),
)

cc_args_list(
    name = "sysroot_flags",
    args = select({
        "//constraints/windows/abi:msvc": [],
        "//conditions:default": ["//toolchain/args:empty_sysroot_flags"],
    }),
)

cc_args_list(
    name = "hermetic_compile_flags",
    args = select({
        "//constraints/windows/abi:msvc": ["//toolchain/args/windows/msvc:hermetic_compile"],
        "//conditions:default": ["//toolchain/args:hermetic_compile_flags"],
    }),
)

cc_args_list(
    name = "stdlib",
    args = select({
        "//constraints/windows/abi:msvc": [],
        "//conditions:default": ["//toolchain/args:stdlib"],
    }),
)

cc_args_list(
    name = "unwindlib",
    args = select({
        "//constraints/windows/abi:msvc": [],
        "//conditions:default": ["//toolchain/args:unwindlib_none"],
    }),
)

# The supported native MSVC-ABI route composes the clang-cl personality with
# Windows/MSVC target policy. Keep the two axes explicit while preserving the
# established argument order.
cc_args_list(
    name = "msvc_target_compile_args",
    args = [
        "//toolchain/args/windows/msvc:compatibility",
        "//toolchain/args:clang_cl_suppress_compiler_banner",
        "//toolchain/args/windows/msvc:reproducible_coff_objects",
        "//toolchain/args:clang_cl_default_exception_handling",
        "//toolchain/args:clang_cl_default_rtti",
        "//toolchain/args/windows/msvc:large_coff_objects",
        "//toolchain/args/windows/msvc:windows_sdk_compile_defines",
    ],
)

cc_args_list(
    name = "target_compile_args",
    args = select({
        "//constraints/windows/abi:msvc": ["msvc_target_compile_args"],
        "//conditions:default": [],
    }),
)

cc_args_list(
    name = "crt_compile_args",
    args = select({
        "//constraints/windows/abi:msvc": ["//toolchain/args/windows/msvc:msvc_crt_compile_defines"],
        "//conditions:default": [],
