load("@bazel_lib//:bzl_library.bzl", "bzl_library")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load(":case_insensitive_copy.bzl", "case_insensitive_copy_directory")
load(":case_insensitive_vfs.bzl", "case_insensitive_vfs_overlay")
load(":directory_info.bzl", "directory_info", "validated_directory_info")
load(":versions.bzl", "MSVC_PAYLOAD_VERSION", "WINDOWS_SDK_INCLUDE_VERSION")

package(default_visibility = ["//visibility:public"])

_MSVC_DYNAMIC_RUNTIME_LIBRARIES = [
    "iso_stdio_wide_specifiers.lib",
    "msvcprt.lib",
    "msvcrt.lib",
    "oldnames.lib",
    "vcruntime.lib",
]

_MSVC_STATIC_RUNTIME_LIBRARIES = [
    "iso_stdio_wide_specifiers.lib",
    "libcmt.lib",
    "libcpmt.lib",
    "libvcruntime.lib",
    "oldnames.lib",
]

# Keep Layer 1's VCRuntime ABI surface separate from Microsoft STL. These are
# the compiler/exception runtime headers required by clang-cl and libc++; the
# selected C++ standard-library headers still come exclusively from libc++.
_MSVC_VCRUNTIME_HEADERS = [
    "CodeAnalysis/sourceannotations.h",
    "concurrencysal.h",
    "crtdefs.h",
    "eh.h",
    "ehdata.h",
    "ehdata_forceinclude.h",
    "ehdata_values.h",
    "excpt.h",
    "sal.h",
    "setjmp.h",
    "setjmpex.h",
    "threads.h",
    "vadefs.h",
    "vcruntime.h",
    "vcruntime_exception.h",
    "vcruntime_new.h",
    "vcruntime_new_debug.h",
    "vcruntime_string.h",
    "vcruntime_startup.h",
    "vcruntime_typeinfo.h",
]

validated_directory_info(
    name = "msvc_include",
    src = "@msvc_runtime//:msvc_include",
    expected_path_suffix = "/Contents/VC/Tools/MSVC/{}/include".format(MSVC_PAYLOAD_VERSION),
)

[
    validated_directory_info(
        name = "winsdk_{}_include".format(directory),
        src = "@windows_sdk//:winsdk_{}_include".format(directory),
        expected_path_suffix = "/base/c/Include/{}/{}".format(WINDOWS_SDK_INCLUDE_VERSION, directory),
    )
    for directory in [
        "shared",
        "ucrt",
        "um",
        "winrt",
    ]
]

validated_directory_info(
    name = "winsdk_ucrt_lib",
    src = "@windows_sdk//:winsdk_ucrt_lib",
    expected_path_suffix = select({
        "//platforms/config:windows_aarch64_msvc": "/arm64/c/ucrt/arm64",
        "//conditions:default": "/x64/c/ucrt/x64",
    }),
)

validated_directory_info(
    name = "winsdk_um_lib",
    src = "@windows_sdk//:winsdk_um_lib",
    expected_path_suffix = select({
        "//platforms/config:windows_aarch64_msvc": "/arm64/c/um/arm64",
        "//conditions:default": "/x64/c/um/x64",
    }),
)

validated_directory_info(
    name = "msvc_lib_arm64",
    src = "@msvc_runtime//:msvc_lib_arm64",
    expected_path_suffix = "/Contents/VC/Tools/MSVC/{}/lib/arm64".format(MSVC_PAYLOAD_VERSION),
)

validated_directory_info(
    name = "msvc_lib_x64",
    src = "@msvc_runtime//:msvc_lib_x64",
    expected_path_suffix = "/Contents/VC/Tools/MSVC/{}/lib/x64".format(MSVC_PAYLOAD_VERSION),
)

copy_to_directory(
    name = "msvc_vcruntime_headers_source",
    srcs = [":msvc_include"],
    include_external_repositories = ["**"],
    include_srcs_patterns = _MSVC_VCRUNTIME_HEADERS,
    root_paths = ["**/include"],
)

directory_info(
    name = "msvc_vcruntime_headers",
    src = ":msvc_vcruntime_headers_source",
)

case_insensitive_vfs_overlay(
    name = "msvc_sdk_case_overlay",
    roots = [
        ":msvc_vcruntime_headers",
        ":winsdk_shared_include",
        ":winsdk_ucrt_include",
        ":winsdk_um_include",
        ":winsdk_winrt_include",
    ],
)

case_insensitive_copy_directory(
    name = "winsdk_ucrt_libraries",
    src = ":winsdk_ucrt_lib",
)

case_insensitive_copy_directory(
    name = "winsdk_um_libraries",
    src = ":winsdk_um_lib",
)

copy_to_directory(
    name = "msvc_dynamic_runtime_libraries",
    srcs = select({
        "//platforms/config:windows_aarch64_msvc": [":msvc_lib_arm64"],
        "//platforms/config:windows_x86_64_msvc": [":msvc_lib_x64"],
        "//conditions:default": [],
    }),
    include_external_repositories = ["**"],
    include_srcs_patterns = _MSVC_DYNAMIC_RUNTIME_LIBRARIES,
    root_paths = [
        "**/lib/arm64",
        "**/lib/x64",
    ],
)

copy_to_directory(
    name = "msvc_static_runtime_libraries",
    srcs = select({
        "//platforms/config:windows_aarch64_msvc": [":msvc_lib_arm64"],
        "//platforms/config:windows_x86_64_msvc": [":msvc_lib_x64"],
        "//conditions:default": [],
    }),
    include_external_repositories = ["**"],
    include_srcs_patterns = _MSVC_STATIC_RUNTIME_LIBRARIES,
    root_paths = [
        "**/lib/arm64",
        "**/lib/x64",
    ],
)

bzl_library(
    name = "directory_info",
    srcs = ["directory_info.bzl"],
    deps = ["@bazel_skylib//rules/directory"],
)

bzl_library(
    name = "case_insensitive_copy",
    srcs = ["case_insensitive_copy.bzl"],
    deps = ["@bazel_skylib//rules/directory"],
)

bzl_library(
    name = "case_insensitive_vfs",
    srcs = ["case_insensitive_vfs.bzl"],
    deps = ["@bazel_skylib//rules/directory"],
)

bzl_library(
    name = "versions",
    srcs = ["versions.bzl"],
)
