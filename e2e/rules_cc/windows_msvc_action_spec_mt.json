{
  "assertions": [
    {
      "mnemonic": "CppCompile",
      "selector_outputs_contain": ["windows_msvc_libcxx_behavior.obj"],
      "executable_contains": "clang-cl",
      "argv_contains": ["@bazel-out/"],
      "argv_absent": ["/MDd", "/MTd", "_DEBUG"],
      "expected_param_files": 1
    },
    {
      "mnemonic": "CppLink",
      "selector_outputs_contain": ["windows_msvc_libcxx_behavior_static.exe"],
      "executable_contains": "lld-link",
      "argv_contains": [
        "/MACHINE:X64",
        "/NODEFAULTLIB",
        "libc++.lib",
        "clang_rt.builtins.lib",
        "iso_stdio_wide_specifiers.lib",
        "libcmt.lib",
        "libcpmt.lib",
        "libvcruntime.lib",
        "ucrt.lib"
      ],
      "argv_absent": ["msvcrt.lib", "msvcprt.lib", "/MD", "/MDd", "/MTd", "_DEBUG"],
      "inputs_contain": ["clang_rt.builtins.lib", "msvc_static_runtime_libraries"],
      "inputs_absent": ["msvc_dynamic_runtime_libraries"],
      "outputs_contain": ["windows_msvc_libcxx_behavior_static.exe"]
    }
  ]
}
