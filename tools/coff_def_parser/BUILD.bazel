load("@llvm//:defs.bzl", "exec_test")
load("@llvm//toolchain/runtimes:cc_runtime_binary.bzl", "cc_runtime_complete_binary")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

# Ported from bazelbuild/bazel df9cf21c8bf643f374790b0c2bc75686293b7024,
# third_party/def_parser. The accompanying BSD notice remains unchanged.
cc_runtime_complete_binary(
    name = "coff_def_parser",
    srcs = [
        "def_parser.cc",
        "def_parser.h",
        "def_parser_main.cc",
    ],
)

exec_test(
    name = "test",
    srcs = [
        "def_parser.cc",
        "def_parser.h",
        "def_parser_test.cc",
    ],
    rule = cc_test,
)

exec_test(
    name = "cli_test",
    srcs = ["cli_test.sh"],
    env = {"DEF_PARSERS": "$(rootpaths coff_def_parser)"},
    rule = sh_test,
    tools = ["coff_def_parser"],
)
