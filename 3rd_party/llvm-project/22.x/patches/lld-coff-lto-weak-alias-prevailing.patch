diff --git a/lld/test/COFF/thinlto-weak-alias-prevailing.ll b/lld/test/COFF/thinlto-weak-alias-prevailing.ll
new file mode 100644
index 000000000000..daae8f3833c0
--- /dev/null
+++ b/lld/test/COFF/thinlto-weak-alias-prevailing.ll
@@ -0,0 +1,58 @@
+; REQUIRES: x86
+
+; RUN: split-file %s %t
+; RUN: opt -thinlto-bc %t/a.ll -o %t/a.obj
+; RUN: opt -thinlto-bc %t/b.ll -o %t/b.obj
+
+;; A owns the prevailing COMDAT aliasee when it precedes B, but B is the only
+;; file that defines vector_dtor. The alias must prevail in B rather than in the
+;; unrelated owner of its selected fallback.
+; RUN: lld-link /entry:entry /subsystem:console /thinlto-index-only %t/a.obj %t/b.obj
+; RUN: llvm-dis %t/b.obj.thinlto.bc -o - | FileCheck %s --check-prefix=LIVE
+; RUN: opt -passes='thinlto<O2>' -summary-file=%t/a.obj.thinlto.bc %t/a.obj -o %t/a.ab.bc
+; RUN: opt -passes='thinlto<O2>' -summary-file=%t/b.obj.thinlto.bc %t/b.obj -o %t/b.ab.bc
+; RUN: llc -filetype=obj %t/a.ab.bc -o %t/a.ab.obj
+; RUN: llc -filetype=obj %t/b.ab.bc -o %t/b.ab.obj
+; RUN: lld-link /entry:entry /subsystem:console /out:%t/ab.exe %t/a.ab.obj %t/b.ab.obj
+
+;; Reversing the inputs selects B's COMDAT and must preserve the same alias.
+; RUN: rm -f %t/a.obj.thinlto.bc %t/b.obj.thinlto.bc
+; RUN: lld-link /entry:entry /subsystem:console /thinlto-index-only %t/b.obj %t/a.obj
+; RUN: llvm-dis %t/b.obj.thinlto.bc -o - | FileCheck %s --check-prefix=LIVE
+; RUN: opt -passes='thinlto<O2>' -summary-file=%t/a.obj.thinlto.bc %t/a.obj -o %t/a.ba.bc
+; RUN: opt -passes='thinlto<O2>' -summary-file=%t/b.obj.thinlto.bc %t/b.obj -o %t/b.ba.bc
+; RUN: llc -filetype=obj %t/a.ba.bc -o %t/a.ba.obj
+; RUN: llc -filetype=obj %t/b.ba.bc -o %t/b.ba.obj
+; RUN: lld-link /entry:entry /subsystem:console /out:%t/ba.exe %t/b.ba.obj %t/a.ba.obj
+
+; LIVE: summaries: (alias: {{.*}}live: 1
+
+;--- a.ll
+target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
+target triple = "x86_64-pc-windows-msvc"
+
+$scalar_dtor = comdat any
+
+define linkonce_odr void @scalar_dtor() comdat {
+  ret void
+}
+
+;--- b.ll
+target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
+target triple = "x86_64-pc-windows-msvc"
+
+$scalar_dtor = comdat any
+$vtable = comdat any
+
+@vector_dtor = weak alias void (), ptr @scalar_dtor
+@vtable = linkonce_odr constant [1 x ptr] [ptr @vector_dtor], comdat
+
+define linkonce_odr void @scalar_dtor() comdat {
+  ret void
+}
+
+define i32 @entry() {
+  %slot = load ptr, ptr @vtable
+  call void %slot()
+  ret i32 0
+}
