freebsd_generate(
    name = "freebsd_syscalls",
    srcs = [
        "lib/libsys/Makefile.sys",
        "lib/libsys/{}/Makefile.sys".format(FREEBSD_ARCH),
        "libexec/rtld-elf/rtld-libc/Makefile.inc",
        "sys/sys/syscall.mk",
    ],
    outs = ["freebsd_syscalls.S"],
    args = [
        "libsys",
        FREEBSD_ARCH,
        "$(execpath freebsd_syscalls.S)",
        "$(location sys/sys/syscall.mk)",
        "$(location lib/libsys/Makefile.sys)",
        "$(location lib/libsys/{}/Makefile.sys)".format(FREEBSD_ARCH),
        "$(location libexec/rtld-elf/rtld-libc/Makefile.inc)",
    ],
    mnemonic = "FreebsdSyscalls",
    tool = "@llvm//3rd_party/freebsd:syscall_assembly_generator",
)

freebsd_generate(
    name = "freebsd_rtld_syscalls",
    srcs = [
        "lib/libsys/Makefile.sys",
        "lib/libsys/{}/Makefile.sys".format(FREEBSD_ARCH),
        "libexec/rtld-elf/rtld-libc/Makefile.inc",
        "sys/sys/syscall.mk",
    ],
    outs = ["freebsd_rtld_syscalls.S"],
    args = [
        "rtld",
        FREEBSD_ARCH,
        "$(execpath freebsd_rtld_syscalls.S)",
        "$(location sys/sys/syscall.mk)",
        "$(location lib/libsys/Makefile.sys)",
        "$(location lib/libsys/{}/Makefile.sys)".format(FREEBSD_ARCH),
        "$(location libexec/rtld-elf/rtld-libc/Makefile.inc)",
    ],
    mnemonic = "FreebsdRtldSyscalls",
    tool = "@llvm//3rd_party/freebsd:syscall_assembly_generator",
)

