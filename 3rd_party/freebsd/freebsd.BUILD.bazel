package(default_visibility = ["//visibility:public"])

_LONG_DOUBLE_DIRECTORY = "ld128" if FREEBSD_ARCH == "aarch64" else "ld80"

_MSUN_ARCH = "aarch64" if FREEBSD_ARCH == "aarch64" else "x86"

_GENERATED_STRING_ASSEMBLY_SRCS = ["generated_aarch64_string_assembly_sources"] if FREEBSD_ARCH == "aarch64" else []

_RTLD_ASM_SRCS = [
    "lib/csu/common/crtbrand.S",
    "libexec/rtld-elf/{}/rtld_start.S".format(FREEBSD_ARCH),
]

_RTLD_SUPPORT_ASM_SRCS = [
    "freebsd_rtld_syscalls",
    "lib/libc/{}/gen/_setjmp.S".format(FREEBSD_ARCH),
    "lib/libc/{}/gen/setjmp.S".format(FREEBSD_ARCH),
    "lib/libc/{}/gen/sigsetjmp.S".format(FREEBSD_ARCH),
    "lib/libsys/{}/cerror.S".format(FREEBSD_ARCH),
]

_PUBLIC_HEADER_PREFIXES = ({
    "include": "",
    "lib/msun/{}".format(_MSUN_ARCH): "",
    "lib/msun/src": "",
    "sys/amd64/include": "machine",
    "sys/x86/include": "x86",
    "sys": "",
} if FREEBSD_ARCH == "amd64" else {
    "include": "",
    "lib/msun/{}".format(_MSUN_ARCH): "",
    "lib/msun/src": "",
    "sys/{}/include".format(FREEBSD_MACHINE_ARCH): "machine",
    "sys": "",
})

